{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "strainer",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": ".", "binding": "ASSETS", "run_worker_first": true },
  "ratelimits": [
    { "name": "CHECK_LIMIT", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }
  ],
  "vars": { "POSTHOG_KEY": "phc_pkNp2dKYGXVrR8oMJzH35f4et3xNSL5hraXMkuQHuBr5", "POSTHOG_HOST": "https://eu.i.posthog.com" },
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": true } },
  "previews": {
    "vars": { "POSTHOG_KEY": "phc_pkNp2dKYGXVrR8oMJzH35f4et3xNSL5hraXMkuQHuBr5", "POSTHOG_HOST": "https://eu.i.posthog.com" },
    "ratelimits": [
      { "name": "CHECK_LIMIT", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } }
    ]
  }
}
